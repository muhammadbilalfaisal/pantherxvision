# Full Formspree form endpoint, for example: https://formspree.io/f/xabcdefg
VITE_FORMSPREE_ENDPOINT=

# Server-only review system variables (configure in Netlify, never prefix with VITE_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
REVIEW_RATE_LIMIT_SALT=
# Comma-separated Supabase Auth emails allowed to use /admin/reviews.
ADMIN_EMAILS=
